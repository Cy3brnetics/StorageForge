# StorageForge: every setting the compose files read, with its default. Copy to .env beside docker-compose.yml and change
# only what you need: a line left commented out keeps the default. .env is git-ignored; never commit it.
#   cp .env.example .env
# Values here are plain text to anyone who can read the file or run `docker inspect`: keep secrets in files (the *_FILE
# settings) that only root can read, not in this file.

# ── The web UI (docker-compose.yml) ───────────────────────────────────────
# Where the proxy listens. 0.0.0.0 is the LAN; 127.0.0.1 keeps it to this machine (and the tailnet, below).
#STORAGEFORGE_HTTPS_BIND=0.0.0.0
#STORAGEFORGE_HTTPS_PORT=8443
# Extra names and addresses for the self-signed certificate, comma-separated (the host's name and address are always in it).
#STORAGEFORGE_TLS_NAMES=storageforge.lan,10.42.0.3
# 1: the session cookie only travels over https, which the proxy always is. 0 only for a test behind your own plain-http setup.
#STORAGEFORGE_COOKIE_SECURE=1
# A cookie name of its own when several StorageForge sites share one machine (docker/sf-site sets it).
#STORAGEFORGE_COOKIE_SUFFIX=
# Proxies in front of the app that add X-Forwarded-For. The built-in proxy is 1; add one per proxy you put in front of it.
#STORAGEFORGE_PROXY_HOPS=1
# The bridge the stack's network gets, so a host firewall can name it (e.g. ufw allow in on br-sforge to any port 22).
#STORAGEFORGE_BRIDGE=br-sforge

# ── The stack on your tailnet (docker-compose.yml, service tailscale; docs/install.md, Tailscale) ──
# With a key, the UI is also at https://<hostname>.<tailnet>.ts.net and tailnet (100.x) hosts are reached over the tailnet.
# Without one, nothing joins. The key is needed only for the first join: the node is kept in the sf-tailscale volume, so take
# the key out again afterwards (`docker inspect` shows it while it is set). A single-use, tagged key is the safest kind.
# A deploy tool that only has the repository (Dockhand, Portainer, Komodo): set the key itself in its environment.
#STORAGEFORGE_TS_AUTHKEY=tskey-auth-...
# Or, where compose runs on the Docker host and can read its files: a file only root can read, instead of the key.
#STORAGEFORGE_TS_AUTHKEY_FILE=/etc/storageforge/ts-authkey
#STORAGEFORGE_TS_HOSTNAME=storageforge
# Where tailscale serve sends the tailnet's requests: the proxy, by its compose name. If the log says "lookup proxy ... no such
# host", use the proxy's published port on this host instead, such as https+insecure://10.42.0.3:8443.
#STORAGEFORGE_TS_UPSTREAM=https+insecure://proxy:8443

# ── Scans, backups and logs (docker-compose.yml) ─────────────────────────
# How often each host is scanned (30m, 6h, 1d), and how many hosts at once.
#STORAGEFORGE_SCAN_INTERVAL=6h
#STORAGEFORGE_SCAN_WORKERS=4
# The nightly backup: the local hour it runs, how many essentials backups to keep, and how many full copies (0: none; they are large).
#STORAGEFORGE_BACKUP_HOUR=3
#STORAGEFORGE_BACKUP_KEEP=14
#STORAGEFORGE_BACKUP_FULL_KEEP=0
# What goes into the access log: all requests, only changes, or nothing.
#STORAGEFORGE_ACCESS_LOG=changes
# The git repository releases are tagged in, to tell you when a new one is out. Unset: releases are not checked.
#STORAGEFORGE_UPDATE_URL=
# Kernel messages from hosts over UDP (netconsole), such as 0.0.0.0:6666. Publish the port too: docker-compose.netconsole.yml.
#STORAGEFORGE_NETCONSOLE_LISTEN=

# ── Folders on the Docker host (docker-compose.yml) ──────────────────────
# Secrets from docker/init-secrets.sh, for a stack that had them before the secret volumes. Empty otherwise.
#STORAGEFORGE_SECRETS_DIR=./secrets
# The host group that may read ./keys (docker/init-secrets.sh makes it).
#STORAGEFORGE_SECRETS_GID=1000
# A one-shot key import: put private keys here (file name = key name), start, then empty it.
#STORAGEFORGE_KEY_IMPORT_DIR=./keys
# Where `docker compose run --rm admin reset` writes a site's archive. Make it first: sudo install -d -o 10001 -g 10001 -m 0700 archive
#STORAGEFORGE_ARCHIVE_DIR=./archive
# Fingerprints in use on other sites of this machine (docker/sf-site writes it).
#STORAGEFORGE_FOREIGN_KEYS=/dev/null

# ── Remote nodes that dial in (docker-compose.remote.yml; docs/remote-nodes.md) ──
# The one port to open to the internet for them. 443 where only web traffic gets out of the nodes' network.
#STORAGEFORGE_TUNNEL_BIND=0.0.0.0
#STORAGEFORGE_TUNNEL_PORT=2222

# ── The key enclave (docker-compose.enclave.yml; docs/security.md, Key enclave) ──
# Required with that file: the group of /dev/kvm on the Docker host (stat -c %g /dev/kvm).
#STORAGEFORGE_KVM_GID=
# Optional: the enclave image digest to insist on (docs/operations.md, Key enclave).
#STORAGEFORGE_ENCLAVE_IMAGE=
# "required": the enclave insists on step-up when it is unlocked, whatever records are shown (enclave_stepup.py).
#STORAGEFORGE_ENCLAVE_STEPUP=
# The folder holding the host share for the vault's second lock (sudo install -d -o 10001 -g 10001 -m 0700 /etc/storageforge).
#STORAGEFORGE_HOST_SHARE_DIR=./host-share

# ── The agent receiver (docker-compose.agent.yml; docs/agent.md) ─────────
# Where agents dial, as the web app tells them, and where the receiver listens.
#STORAGEFORGE_AGENT_ENDPOINT=storageforge.lan:7843
#STORAGEFORGE_AGENT_BIND=0.0.0.0
#STORAGEFORGE_AGENT_PORT=7843
# Its database. On SQLite it shares the data volume; with PostgreSQL give it its own role (agentreceiver grant ROLE prints the grants).
#STORAGEFORGE_AGENT_RECEIVER_DB=sqlite:////app/data/index.db

# ── The sfnet overlay (docker-compose.sfnet.yml) ─────────────────────────
#STORAGEFORGE_SFNET_BIND=0.0.0.0

# ── The netconsole port (docker-compose.netconsole.yml) ──────────────────
#STORAGEFORGE_NETCONSOLE_BIND=127.0.0.1
#STORAGEFORGE_NETCONSOLE_PORT=6666
